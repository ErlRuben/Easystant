{
    "manifest_version": 3,
    "name": "Easystant",
    "version": "0.1.0",
    "description": "AI-powered assistant for communication, task creation, and workflow optimization",
    "permissions": [
        "contextMenus",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>",
        "https://*.vercel.app/*"
    ],
    "background": {
        "service_worker": "src/background.js"
    },
    "action": {
        "default_popup": "public/panel.html",
        "default_title": "Easystant",
        "default_icon": {
            "128": "public/icons/Recon Tech Logo.png"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["src/content-script.js"],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "128": "public/icons/Recon Tech Logo.png"
    }
}